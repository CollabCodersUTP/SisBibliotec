# -----------------------------------------------------------------------------
# Directorios de dependencias
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/ # Directorio de dependencias de Snowpack (https://snowpack.dev/)

# -----------------------------------------------------------------------------
# Registros (Logs) y Diagnósticos
# -----------------------------------------------------------------------------
# Registros
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log* # Registros de pnpm (añadido)

# Reportes de diagnóstico (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# -----------------------------------------------------------------------------
# Directorios de Compilación/Salida (Build/Output)
# -----------------------------------------------------------------------------
# Salida de compilación de Next.js
.next
out

# Salida de compilación/generación de Nuxt.js
.nuxt
dist
.output # Directorio de salida de Nuxt 3 (añadido)

# Archivos de Gatsby
.cache/
# Descomenta la línea 'public' si tu proyecto usa Gatsby y no Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# Salida de compilación de vitepress
**/.vitepress/dist

# Salida de compilación de Vite (a menudo 'dist', pero útil para separar)
dist/
build/
es/
lib/
public/build/

# Salida de compilación de vuepress
.vuepress/dist

# Directorio temporal y de caché de vuepress v2.x
.temp
.cache

# Directorio de caché de Sveltekit
.svelte-kit/

# Archivos generados y de caché de Docusaurus
.docusaurus

# Salida de compilación de Astro
dist/

# Compilación de Storybook
storybook-static/

# Addons binarios compilados (https://nodejs.org/api/addons.html)
build/Release

# -----------------------------------------------------------------------------
# Reportes de Pruebas/Cobertura
# -----------------------------------------------------------------------------
# Directorio de cobertura usado por herramientas como istanbul
coverage
*.lcov

# Cobertura de pruebas de nyc
.nyc_output

# Directorio para librerías instrumentadas generadas por jscoverage/JSCover
lib-cov

# -----------------------------------------------------------------------------
# Cachés
# -----------------------------------------------------------------------------
# Caché de parcel-bundler (https://parceljs.com/)
.cache
.parcel-cache
.parcel-server # Servidor de Parcel (añadido)

# Directorio opcional de caché de npm
.npm

# Directorio opcional de caché de pnpm
.pnpm-store # Almacén (store) de pnpm (añadido)

# Caché opcional de eslint
.eslintcache

# Caché opcional de stylelint
.stylelintcache

# Caché de TypeScript
*.tsbuildinfo

# Almacenamiento intermedio de Grunt (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Directorio de caché de vitepress
**/.vitepress/cache

# Directorios de Serverless
.serverless/

# Caché de FuseBox
.fusebox/

# Archivos locales de DynamoDB
.dynamodb/

# Directorio de caché de Firebase
.firebase/

# Caché de Yarn
.yarn-cache

# Archivos de registro (logs) de Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# -----------------------------------------------------------------------------
# Datos de Tiempo de Ejecución (Runtime) y Configuración
# -----------------------------------------------------------------------------
# Datos de tiempo de ejecución
pids
*.pid
*.seed
*.pid.lock

# Configuración de node-waf
.lock-wscript

# Salida de 'npm pack' / archivos de paquetes
*.tgz
*.tar.gz # Tarballs generales (añadido)

# Archivo de Integridad de Yarn
.yarn-integrity

# Historial opcional de REPL
.node_repl_history

# Archivo de puerto de TernJS
.tern-port

# Almacena las versiones de VSCode usadas para probar extensiones
.vscode-test

# Directorio de dependencias de Bower (https://bower.io/) - mantenido por compatibilidad
bower_components

# Archivos de variables de entorno dotenv
.env
.env.*
!.env.example # Mantener el archivo de ejemplo
.env.local # Convención común para entorno local (añadido)

# -----------------------------------------------------------------------------
# Específicos del Administrador de Paquetes (Yarn v3/pnpm)
# -----------------------------------------------------------------------------
# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# pnpm
# Ignorados específicos de pnpm (opcional, a menudo manejados por la config de pnpm)
# pnpm-lock.yaml # Usualmente se rastrea, pero si no:

# -----------------------------------------------------------------------------
# Archivos de IDE y Sistema Operativo (OS)
# -----------------------------------------------------------------------------
.vscode/* # Ajustes de VSCode (añadido)
!.vscode/extensions.json # Excepto el archivo de extensiones
.idea/ # IDEs de JetBrains (IntelliJ, WebStorm, etc.) (añadido)
.DS_Store # Archivo de sistema de macOS (añadido)
Thumbs.db # Archivo de sistema de Windows (añadido)