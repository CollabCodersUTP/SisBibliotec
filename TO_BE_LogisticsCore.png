digraph TO_BE_Logistics_Core {
	fontsize=12 label="Proceso TO BE - AJE Logistics Core" labelloc=top rankdir=TB
	start [label="[INICIO]
Planificación Inteligente de Rutas y Gestión de Pedidos" shape=rectangle]
	sgrm [label="Sistema SGRM + ERP Integrado
Consulta automática de pedidos
e inventario en tiempo real" shape=rectangle]
	alc_inv [label="ALC: Verificación automática de inventario
y predicción de stock" shape=rectangle]
	decision_stock [label="¿Stock insuficiente?" shape=diamond]
	repos [label="Sistema genera orden de reposición automática" shape=rectangle]
	alc_opt [label="ALC: Algoritmo de optimización con IA
(tráfico, clima, peso, ventanas, flota)" shape=rectangle]
	alc_route [label="ALC: Asignación automática de ruta optimizada" shape=rectangle]
	planner [label="Planificador:
Supervisión y aprobación rápida" shape=rectangle]
	notify_driver [label="ALC: Notificación automática al conductor
(vía app mejorada)" shape=rectangle]
	driver_start [label="Conductor: Inicia ruta
desde app con navegación integrada" shape=rectangle]
	iot [label="Sistema IoT/GPS:
Monitoreo en tiempo real" shape=rectangle]
	compare [label="ALC: Comparación ruta planificada vs real" shape=rectangle]
	decision_inc [label="¿Incidente detectado?" shape=diamond]
	alt_route [label="ALC: Genera nueva ruta
alternativa automáticamente" shape=rectangle]
	send_driver [label="ALC: Envía nueva ruta al conductor" shape=rectangle]
	notify_client [label="ALC: Notificación proactiva a cliente
con ETA actualizado" shape=rectangle]
	deliver [label="Conductor: Entrega completada
con confirmación digital (QR/Firma)" shape=rectangle]
	report [label="Conductor: Reporta incidencias
con categorías predefinidas" shape=rectangle]
	close [label="ALC: Cierre automático del pedido
y actualización de inventario" shape=rectangle]
	sync [label="ALC: Sincronización con SGRM y ERP" shape=rectangle]
	metrics [label="ALC: Registro automático de métricas" shape=rectangle]
	analytics [label="Analytics: Dashboard y análisis predictivo
en tiempo real" shape=rectangle]
	end [label="[FIN]
Generación de insights" shape=rectangle]
	start -> sgrm
	sgrm -> alc_inv
	alc_inv -> decision_stock
	decision_stock -> repos [label=SI]
	decision_stock -> alc_opt [label=NO]
	alc_opt -> alc_route
	alc_route -> planner
	planner -> notify_driver
	notify_driver -> driver_start
	driver_start -> iot
	iot -> compare
	compare -> decision_inc
	decision_inc -> alt_route [label=SI]
	alt_route -> send_driver
	send_driver -> notify_client
	notify_client -> deliver
	decision_inc -> deliver [label=NO]
	deliver -> report
	report -> close
	close -> sync
	sync -> metrics
	metrics -> analytics
	analytics -> end
}
